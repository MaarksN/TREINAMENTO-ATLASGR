generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  cpf               String?  @unique
  role              String   @default("COLLABORATOR") // "ADMIN", "COLLABORATOR"
  cargo             String?
  departamento      String?
  gestor            String?
  telefone          String?
  empresa           String?
  cidade            String?
  estado            String?
  consentimentoLGPD Boolean  @default(true)
  aceiteTermos      Boolean  @default(true)
  tenantId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Gamification Relations
  gamificationProfile GamificationProfile?
  achievements        UserAchievement[]
  moduleProgress      ModuleProgress[]
}

model GamificationProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  xp             Int      @default(0)
  level          Int      @default(1)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String
  type        String   @default("BADGE") // "BADGE", "MEDAL", "CERTIFICATE"
  iconSvg     String?
  pointsValue Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Module {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  category    String
  createdAt   DateTime @default(now())

  progress    ModuleProgress[]
}

model ModuleProgress {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String
  status      String   @default("NOT_STARTED") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  score       Int?     // e.g. Quiz score
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id])
  module      Module   @relation(fields: [moduleId], references: [id])

  answers     QuizAnswer[]

  @@unique([userId, moduleId])
}

model QuizAnswer {
  id               String         @id @default(uuid())
  moduleProgressId String
  questionId       String
  selectedOption   Int
  isCorrect        Boolean
  createdAt        DateTime       @default(now())

  moduleProgress   ModuleProgress @relation(fields: [moduleProgressId], references: [id], onDelete: Cascade)
}
